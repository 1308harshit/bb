{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "customConditions": ["source"],
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@/components/ui/icon": [
        "../../packages/plugin-registry/flavors/components/ui/icon.tsx"
      ],
      "@/*": ["../../packages/shared-ui/src/*"]
    }
  },
  "include": [
    "server.ts",
    "app.tsx",
    "contract.ts",
    "src",
    "*.test.ts",
    "*.test.tsx",
    "vitest.config.ts"
  ]
}
